#include <SoftwareSerial.h>

// Define the pins for the SoftwareSerial communication with the HC-05
// Connect HC-05 TX to Arduino RX (e.g., pin 2)
// Connect HC-05 RX to Arduino TX (e.g., pin 3)
SoftwareSerial BT_Serial(2, 3); 

// Define the Arduino pins connected to the relay module's IN pins
#define RELAY1_PIN 4 
#define RELAY2_PIN 5
#define RELAY3_PIN 6
#define RELAY4_PIN 7

char receivedChar; // Variable to store data received from Bluetooth

void setup() {
  // Initialize serial communication with the computer for debugging
  Serial.begin(9600); 
  // Initialize serial communication with the Bluetooth module
  BT_Serial.begin(9600); 

  // Set relay pins as OUTPUT
  pinMode(RELAY1_PIN, OUTPUT);
  pinMode(RELAY2_PIN, OUTPUT);
  pinMode(RELAY3_PIN, OUTPUT);
  pinMode(RELAY4_PIN, OUTPUT);

  // Initially turn off all relays (assuming active-low relays)
  digitalWrite(RELAY1_PIN, HIGH); 
  digitalWrite(RELAY2_PIN, HIGH);
  digitalWrite(RELAY3_PIN, HIGH);
  digitalWrite(RELAY4_PIN, HIGH);
}

void loop() {
  // Check if data is available from the Bluetooth module
  if (BT_Serial.available()) {
    receivedChar = BT_Serial.read(); // Read the incoming character

    // Print the received character to the Serial Monitor for debugging
    Serial.print("Received: ");
    Serial.println(receivedChar);

    // Control relays based on the received character
    switch (receivedChar) {
      case '1': // Turn ON Relay 1
        digitalWrite(RELAY1_PIN, LOW); // Assuming active-low relay
        break;
      case 'q': // Turn OFF Relay 1
        digitalWrite(RELAY1_PIN, HIGH); // Assuming active-low relay
        break;
      case '2': // Turn ON Relay 2
        digitalWrite(RELAY2_PIN, LOW);
        break;
      case 'w': // Turn OFF Relay 2
        digitalWrite(RELAY2_PIN, HIGH);
        break;
      case '3': // Turn ON Relay 3
        digitalWrite(RELAY3_PIN, LOW);
        break;
      case 'e': // Turn OFF Relay 3
        digitalWrite(RELAY3_PIN, HIGH);
        break;
      case '4': // Turn ON Relay 4
        digitalWrite(RELAY4_PIN, LOW);
        break;
      case 'r': // Turn OFF Relay 4
        digitalWrite(RELAY4_PIN, HIGH);
        break;
      case 'a': // Turn ON all relays
        digitalWrite(RELAY1_PIN, LOW);
        digitalWrite(RELAY2_PIN, LOW);
        digitalWrite(RELAY3_PIN, LOW);
        digitalWrite(RELAY4_PIN, LOW);
        break;
      case 's': // Turn OFF all relays
        digitalWrite(RELAY1_PIN, HIGH);
        digitalWrite(RELAY2_PIN, HIGH);
        digitalWrite(RELAY3_PIN, HIGH);
        digitalWrite(RELAY4_PIN, HIGH);
        break;
    }
  }
}
